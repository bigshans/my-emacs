;;; inkstone-canghai-theme.el --- 墨观 Inkstone · 沧海 -*- lexical-binding: t; -*-
;;
;; 取色自 ~/.vim/bundle/vim-inkstone 的 canghai 调色板。
;; 这是一个轻量 Emacs 移植，覆盖编辑、补全、Org、Markdown、Magit 等常用 face。

(deftheme inkstone-canghai
  "墨观 Inkstone · 沧海，中国传统色彩主题。")

(let ((class '((class color) (min-colors 89)))
      ;; 基础色
      (bg          "#0d1822")
      (fg          "#c8d4dd")
      (cursor      "#66a9c9")
      (sel         "#1d3644")
      (sel-nc      "#1a2c38")
      (lineno      "#5e7385")
      (lineno-act  "#9aadbb")
      (linehl      "#15202a")
      (bg-alt      "#0a131b")
      (bg-alt2     "#12202b")
      (bg-hard     "#0a131b")
      (widget      "#182833")
      (input       "#152430")
      (border      "#29404f")
      (comment     "#648e93")
      (keyword     "#dc5e41")
      (func        "#63bbd0")
      (method      "#22a2c3")
      (type        "#c08eaf")
      (str         "#1ba784")
      (num         "#d6a01d")
      (param       "#c08eaf")
      (prop        "#b3c2ce")
      (tag         "#e45f6f")
      (attr        "#d6a01d")
      (regex       "#57c3c2")
      (op          "#8fa3b4")
      (punct       "#7f95a6")
      (err         "#e25737")
      (warn        "#d6a01d")
      (info        "#63bbd0")
      (guide       "#1b2b36")
      (guide-act   "#3d5a6d")
      (diffhdr     "#648e93")
      (ins         "#1ba784")
      (del         "#dc5e41")
      (chg         "#d6a01d")
      (match       "#191c24")
      (list-sel    "#20323f")
      (badge-fg    "#0d1822"))

  (custom-theme-set-faces
   'inkstone-canghai

   ;; 基础 UI
   `(default ((,class (:background ,bg :foreground ,fg))))
   `(cursor ((,class (:background ,cursor))))
   `(region ((,class (:background ,sel :foreground ,fg :extend t))))
   `(secondary-selection ((,class (:background ,sel-nc :extend t))))
   `(highlight ((,class (:background ,match))))
   `(hl-line ((,class (:background ,linehl :extend t))))
   `(fringe ((,class (:background ,bg :foreground ,guide))))
   `(vertical-border ((,class (:foreground ,border))))
   `(window-divider ((,class (:foreground ,guide))))
   `(window-divider-first-pixel ((,class (:foreground ,guide))))
   `(window-divider-last-pixel ((,class (:foreground ,guide))))
   `(minibuffer-prompt ((,class (:foreground ,cursor :weight bold))))
   `(shadow ((,class (:foreground ,comment))))
   `(link ((,class (:foreground ,info :underline t))))
   `(link-visited ((,class (:foreground ,type :underline t))))
   `(button ((,class (:foreground ,info :underline t))))
   `(success ((,class (:foreground ,ins :weight bold))))
   `(warning ((,class (:foreground ,warn :weight bold))))
   `(error ((,class (:foreground ,err :weight bold))))

   ;; 行号 / 光标行
   `(line-number ((,class (:background ,bg :foreground ,lineno))))
   `(line-number-current-line ((,class (:background ,linehl :foreground ,lineno-act :weight bold))))
   `(line-number-major-tick ((,class (:background ,bg-alt :foreground ,comment))))
   `(line-number-minor-tick ((,class (:background ,bg-alt :foreground ,guide))))

   ;; mode-line / header-line
   `(mode-line ((,class (:background ,bg-alt2 :foreground ,fg
                                     :box (:line-width 1 :color ,border)))))
   `(mode-line-inactive ((,class (:background ,bg-alt :foreground ,comment
                                              :box (:line-width 1 :color ,guide)))))
   `(mode-line-buffer-id ((,class (:foreground ,cursor :weight bold))))
   `(mode-line-emphasis ((,class (:foreground ,warn :weight bold))))
   `(mode-line-highlight ((,class (:foreground ,info :box (:line-width 1 :color ,border)))))
   `(header-line ((,class (:background ,bg-alt2 :foreground ,fg))))
   `(header-line-inactive ((,class (:background ,bg-alt :foreground ,comment))))

   ;; 搜索 / 匹配
   `(isearch ((,class (:background ,guide-act :foreground ,fg :weight bold))))
   `(isearch-fail ((,class (:background ,err :foreground ,fg))))
   `(lazy-highlight ((,class (:background ,guide :foreground ,fg))))
   `(match ((,class (:background ,match :foreground ,fg))))
   `(show-paren-match ((,class (:background ,sel :foreground ,cursor :weight bold))))
   `(show-paren-mismatch ((,class (:background ,err :foreground ,fg :weight bold))))

   ;; 语法高亮
   `(font-lock-comment-face ((,class (:foreground ,comment :slant italic))))
   `(font-lock-comment-delimiter-face ((,class (:foreground ,comment))))
   `(font-lock-doc-face ((,class (:foreground ,comment :slant italic))))
   `(font-lock-string-face ((,class (:foreground ,str))))
   `(font-lock-keyword-face ((,class (:foreground ,keyword :weight bold))))
   `(font-lock-builtin-face ((,class (:foreground ,func))))
   `(font-lock-function-name-face ((,class (:foreground ,func :weight bold))))
   `(font-lock-variable-name-face ((,class (:foreground ,fg))))
   `(font-lock-type-face ((,class (:foreground ,type))))
   `(font-lock-constant-face ((,class (:foreground ,num))))
   `(font-lock-number-face ((,class (:foreground ,num))))
   `(font-lock-operator-face ((,class (:foreground ,op))))
   `(font-lock-preprocessor-face ((,class (:foreground ,keyword))))
   `(font-lock-regexp-face ((,class (:foreground ,regex))))
   `(font-lock-regexp-grouping-backslash ((,class (:foreground ,regex))))
   `(font-lock-regexp-grouping-construct ((,class (:foreground ,regex))))
   `(font-lock-warning-face ((,class (:foreground ,err :weight bold))))
   `(font-lock-negation-char-face ((,class (:foreground ,err))))

   ;; 补全 / 候选
   `(completions-common-part ((,class (:foreground ,cursor :weight bold))))
   `(completions-first-difference ((,class (:foreground ,keyword))))
   `(corfu-default ((,class (:background ,widget :foreground ,fg))))
   `(corfu-current ((,class (:background ,list-sel :foreground ,fg :weight bold))))
   `(corfu-border ((,class (:background ,border))))
   `(corfu-bar ((,class (:background ,cursor))))
   `(corfu-popupinfo ((,class (:background ,bg-alt2 :foreground ,fg))))
   `(vertico-current ((,class (:background ,sel :foreground ,fg :extend t))))
   `(vertico-group-title ((,class (:foreground ,comment :slant italic))))
   `(vertico-group-separator ((,class (:foreground ,guide))))
   `(orderless-match-face-0 ((,class (:foreground ,cursor :weight bold))))
   `(orderless-match-face-1 ((,class (:foreground ,keyword :weight bold))))
   `(orderless-match-face-2 ((,class (:foreground ,str :weight bold))))
   `(orderless-match-face-3 ((,class (:foreground ,type :weight bold))))

   ;; which-key
   `(which-key-key-face ((,class (:foreground ,cursor :weight bold))))
   `(which-key-separator-face ((,class (:foreground ,comment))))
   `(which-key-command-description-face ((,class (:foreground ,fg))))
   `(which-key-group-description-face ((,class (:foreground ,keyword :weight bold))))
   `(which-key-special-key-face ((,class (:foreground ,warn :weight bold))))

   ;; Dired / 文件树
   `(dired-directory ((,class (:foreground ,func :weight bold))))
   `(dired-symlink ((,class (:foreground ,info))))
   `(dired-header ((,class (:foreground ,keyword :weight bold))))
   `(dired-marked ((,class (:foreground ,warn :weight bold))))
   `(dired-flagged ((,class (:foreground ,err :weight bold))))
   `(dired-ignored ((,class (:foreground ,comment))))
   `(dired-perm-write ((,class (:foreground ,warn))))

   ;; 空白 / 行尾
   `(trailing-whitespace ((,class (:background ,err))))
   `(whitespace-space ((,class (:foreground ,guide))))
   `(whitespace-tab ((,class (:foreground ,guide))))
   `(whitespace-newline ((,class (:foreground ,guide))))
   `(whitespace-indentation ((,class (:foreground ,guide))))
   `(whitespace-empty ((,class (:background ,bg-alt2))))

   ;; Diff / Magit
   `(diff-added ((,class (:foreground ,ins :extend t))))
   `(diff-removed ((,class (:foreground ,del :extend t))))
   `(diff-changed ((,class (:foreground ,chg :extend t))))
   `(diff-hunk-header ((,class (:foreground ,diffhdr :weight bold :extend t))))
   `(diff-file-header ((,class (:foreground ,cursor :weight bold :extend t))))
   `(diff-function ((,class (:foreground ,type :extend t))))
   `(magit-section-highlight ((,class (:background ,linehl :extend t))))
   `(magit-section-heading ((,class (:foreground ,cursor :weight bold))))
   `(magit-diff-added ((,class (:foreground ,ins :extend t))))
   `(magit-diff-removed ((,class (:foreground ,del :extend t))))
   `(magit-diff-added-highlight ((,class (:background ,bg-alt2 :foreground ,ins :extend t))))
   `(magit-diff-removed-highlight ((,class (:background ,bg-alt2 :foreground ,del :extend t))))
   `(magit-diff-hunk-heading ((,class (:foreground ,diffhdr :weight bold :extend t))))
   `(magit-diff-hunk-heading-highlight ((,class (:background ,bg-alt2 :foreground ,diffhdr :weight bold :extend t))))
   `(magit-branch-local ((,class (:foreground ,func))))
   `(magit-branch-remote ((,class (:foreground ,str))))
   `(magit-tag ((,class (:foreground ,num))))
   `(magit-hash ((,class (:foreground ,comment))))
   `(magit-log-author ((,class (:foreground ,type))))
   `(magit-log-date ((,class (:foreground ,comment))))

   ;; Org
   `(org-level-1 ((,class (:foreground ,keyword :weight bold :height 1.25))))
   `(org-level-2 ((,class (:foreground ,func :weight bold :height 1.15))))
   `(org-level-3 ((,class (:foreground ,type :weight bold :height 1.1))))
   `(org-level-4 ((,class (:foreground ,str :weight bold))))
   `(org-level-5 ((,class (:foreground ,num :weight bold))))
   `(org-level-6 ((,class (:foreground ,param :weight bold))))
   `(org-level-7 ((,class (:foreground ,tag :weight bold))))
   `(org-level-8 ((,class (:foreground ,method :weight bold))))
   `(org-document-title ((,class (:foreground ,fg :weight bold :height 1.35))))
   `(org-document-info ((,class (:foreground ,comment))))
   `(org-link ((,class (:foreground ,info :underline t))))
   `(org-code ((,class (:foreground ,func))))
   `(org-verbatim ((,class (:foreground ,str))))
   `(org-table ((,class (:foreground ,fg))))
   `(org-todo ((,class (:foreground ,keyword :weight bold))))
   `(org-done ((,class (:foreground ,str :weight bold))))
   `(org-warning ((,class (:foreground ,warn :weight bold))))
   `(org-block ((,class (:background ,bg-alt :extend t))))
   `(org-block-begin-line ((,class (:background ,bg-alt2 :foreground ,comment :slant italic :extend t))))
   `(org-block-end-line ((,class (:background ,bg-alt2 :foreground ,comment :slant italic :extend t))))
   `(org-quote ((,class (:foreground ,comment :slant italic))))
   `(org-ellipsis ((,class (:foreground ,comment))))
   `(org-hide ((,class (:foreground ,bg))))
   `(org-indent ((,class (:foreground ,bg :background ,bg))))
   `(org-date ((,class (:foreground ,type :underline t))))
   `(org-special-keyword ((,class (:foreground ,comment))))
   `(org-drawer ((,class (:foreground ,comment))))
   `(org-property-value ((,class (:foreground ,fg))))
   `(org-meta-line ((,class (:foreground ,comment))))
   `(org-checkbox ((,class (:foreground ,cursor :weight bold))))
   `(org-checkbox-statistics-todo ((,class (:foreground ,keyword))))
   `(org-checkbox-statistics-done ((,class (:foreground ,str))))

   ;; Markdown
   `(markdown-header-face-1 ((,class (:foreground ,keyword :weight bold :height 1.25))))
   `(markdown-header-face-2 ((,class (:foreground ,func :weight bold :height 1.15))))
   `(markdown-header-face-3 ((,class (:foreground ,type :weight bold :height 1.1))))
   `(markdown-header-face-4 ((,class (:foreground ,str :weight bold))))
   `(markdown-header-face-5 ((,class (:foreground ,num :weight bold))))
   `(markdown-header-face-6 ((,class (:foreground ,param :weight bold))))
   `(markdown-link-face ((,class (:foreground ,info :underline t))))
   `(markdown-url-face ((,class (:foreground ,comment))))
   `(markdown-code-face ((,class (:background ,bg-alt :extend t))))
   `(markdown-inline-code-face ((,class (:background ,bg-alt :foreground ,func))))
   `(markdown-blockquote-face ((,class (:foreground ,comment :slant italic))))
   `(markdown-list-face ((,class (:foreground ,keyword))))
   `(markdown-bold-face ((,class (:foreground ,fg :weight bold))))
   `(markdown-italic-face ((,class (:foreground ,type :slant italic))))

   ;; 浮窗 / 子框架
   `(eldoc-box-body ((,class (:background ,bg-alt2 :foreground ,fg))))
   `(eldoc-box-border ((,class (:background ,border))))
   `(valign-table-fallback ((,class (:inherit fixed-pitch :foreground ,comment))))
   `(child-frame-border ((,class (:background ,border))))

   ;; Tab bar
   `(tab-bar ((,class (:background ,bg-alt :foreground ,comment))))
   `(tab-bar-tab ((,class (:background ,bg-alt2 :foreground ,fg :weight bold))))
   `(tab-bar-tab-inactive ((,class (:background ,bg-alt :foreground ,comment))))
   `(tab-bar-tab-ungrouped ((,class (:background ,bg-alt2 :foreground ,comment))))

   ;; Doom modeline
   `(doom-modeline-buffer-path ((,class (:foreground ,fg))))
   `(doom-modeline-buffer-file ((,class (:foreground ,fg :weight bold))))
   `(doom-modeline-buffer-modified ((,class (:foreground ,warn :weight bold))))
   `(doom-modeline-project-name ((,class (:foreground ,func))))
   `(doom-modeline-project-dir ((,class (:foreground ,comment))))
   `(doom-modeline-panel ((,class (:background ,sel :foreground ,fg))))
   `(doom-modeline-bar ((,class (:background ,cursor))))
   `(doom-modeline-info ((,class (:foreground ,ins))))
   `(doom-modeline-warning ((,class (:foreground ,warn))))
   `(doom-modeline-error ((,class (:foreground ,err))))
   `(doom-modeline-buffer-major-mode ((,class (:foreground ,keyword :weight bold))))
   `(doom-modeline-highlight ((,class (:foreground ,info))))
   `(doom-modeline-urgent ((,class (:foreground ,err :weight bold))))
   `(doom-modeline-inactive ((,class (:foreground ,comment))))

   ;; 其它常用
   `(help-key-binding ((,class (:foreground ,cursor :background ,bg-alt2))))
   `(apropos-keybinding ((,class (:foreground ,cursor))))
   `(web-mode-html-tag-face ((,class (:foreground ,tag))))
   `(web-mode-html-attr-name-face ((,class (:foreground ,attr))))
   `(web-mode-html-attr-value-face ((,class (:foreground ,str)))))

  (custom-theme-set-variables
   'inkstone-canghai
   `(ansi-color-names-vector
     [,bg-alt ,err ,ins ,num ,info ,type ,regex ,fg])))

(provide-theme 'inkstone-canghai)
;;; inkstone-canghai-theme.el ends here
